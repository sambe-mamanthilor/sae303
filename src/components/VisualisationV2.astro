---
import * as Plot from "@observablehq/plot";
import PlotFigure from "./PlotFigure.astro";

// Une station de mesure (données préfiltrées depuis le notebook, cellule « Export V2 »)
interface Station {
  nom: string;
  latitude: number;
  longitude: number;
  altitude: number;
  tx1961_1990: number;
  tx1991_2020: number;
  evolution: number;
}

interface Props {
  stations: Station[];
  contours: any; // FeatureCollection GeoJSON des 8 départements de la région
}

const { stations, contours } = Astro.props;

// Nombre au format français : 1.41 -> « +1,41 »
const virgule = (valeur: number, signe = true) =>
  (signe && valeur > 0 ? "+" : "") + valeur.toFixed(2).replace(".", ",");

// Les deux stations du récit, mises en évidence sur la carte
const stationsCles = ["AERO-MTBL", "DORANS"];

// Même logique que graphiqueV2 dans le notebook : la fonction reçoit ses données en paramètre
function graphiqueV2(donnees: Station[], fond: any) {
  const min = Math.min(...donnees.map((d) => d.evolution));
  const max = Math.max(...donnees.map((d) => d.evolution));
  const aero = donnees.find((d) => d.nom === "AERO-MTBL");

  return {
    width: 640,
    projection: { type: "mercator", domain: fond, inset: 20 },
    title: `Évolution de la température maximale moyenne dans ${donnees.length} longues séries de Bourgogne-Franche-Comté`,
    subtitle: `Entre 1961–1990 et 1991–2020, l’évolution va de ${virgule(min)} à ${virgule(max)} °C selon les stations. AERO-MTBL : ${virgule(aero!.evolution)} °C.`,
    caption:
      "Chaque point est une station de mesure, pas une valeur pour tout le territoire. Écart entre les moyennes de TX annuelle 1991–2020 et 1961–1990. Sources : Météo-France, Longues Séries Homogénéisées ; contours : Etalab, d’après IGN Admin Express.",
    ariaLabel: `Carte de points de la Bourgogne-Franche-Comté : ${donnees.length} stations, toutes réchauffées entre ${virgule(min)} et ${virgule(max)} °C.`,
    style: { background: "transparent", color: "currentColor" },
    // Palette séquentielle : toutes les évolutions sont positives, donc pas de palette divergente.
    // Elle ne commence pas presque blanc pour ne pas suggérer une absence de réchauffement.
    // 4 classes de 0,1 °C (au lieu d'un dégradé continu) : la légende se génère au build sans canvas,
    // et le lecteur associe plus facilement une couleur à un intervalle.
    color: {
      type: "quantize",
      domain: [1.2, 1.6],
      n: 4,
      range: ["#fdbe85", "#f3793a", "#d4361b", "#a50f15"],
      legend: true,
      label: "Évolution (°C)",
      tickFormat: (d: number) => virgule(d).replace(/0$/, ""),
    },
    marks: [
      // Fond de carte : uniquement un repère, il ne porte aucune donnée
      Plot.geo(fond, { fill: "currentColor", fillOpacity: 0.06, stroke: "currentColor", strokeOpacity: 0.35 }),
      Plot.dot(donnees, {
        x: "longitude",
        y: "latitude",
        r: 6,
        fill: "evolution",
        stroke: (d: Station) => (stationsCles.includes(d.nom) ? "currentColor" : "#666"),
        strokeWidth: (d: Station) => (stationsCles.includes(d.nom) ? 2 : 0.6),
        // Infobulle native au survol (le graphique est généré au build, sans JavaScript)
        title: (d: Station) =>
          `${d.nom}\nAltitude : ${d.altitude} m\nTX 1961–1990 : ${virgule(d.tx1961_1990, false)} °C\nTX 1991–2020 : ${virgule(d.tx1991_2020, false)} °C\nÉvolution : ${virgule(d.evolution)} °C`,
      }),
      // DORANS au-dessus de son point, AERO-MTBL en dessous (les deux stations sont à 12 km)
      Plot.text(donnees.filter((d) => d.nom === "DORANS"), {
        x: "longitude", y: "latitude", text: "nom", dy: -13, fontWeight: "bold", fill: "currentColor",
      }),
      Plot.text(donnees.filter((d) => d.nom === "AERO-MTBL"), {
        x: "longitude", y: "latitude", text: "nom", dy: 15, fontWeight: "bold", fill: "currentColor",
      }),
    ],
  };
}
---

<div class="relative" data-v2-map>
  <PlotFigure options={graphiqueV2(stations, contours)} />
  <output
    class="pointer-events-none absolute z-10 hidden max-w-64 whitespace-pre-line rounded-lg border border-slate-200 bg-white px-3 py-2 text-sm leading-relaxed text-slate-950 shadow-xl dark:border-slate-300 dark:bg-slate-100 dark:text-slate-950"
    data-v2-tooltip
    aria-live="polite"
  ></output>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-v2-map]").forEach((carte) => {
    const infobulle = carte.querySelector<HTMLOutputElement>("[data-v2-tooltip]");
    if (!infobulle) return;

    function afficher(point: SVGCircleElement, x: number, y: number) {
      const texte = point.getAttribute("aria-label");
      if (!texte) return;

      infobulle.textContent = texte;
      infobulle.style.left = `${x}px`;
      infobulle.style.top = `${y}px`;
      infobulle.style.transform = "translate(-50%, calc(-100% - 12px))";
      infobulle.classList.remove("hidden");
    }

    function masquer() {
      infobulle.classList.add("hidden");
    }

    carte.querySelectorAll<SVGCircleElement>('svg [aria-label="dot"] circle').forEach((point) => {
      const titreNatif = point.querySelector("title");
      const texte = titreNatif?.textContent?.trim();
      if (!texte) return;

      point.setAttribute("aria-label", texte);
      point.setAttribute("tabindex", "0");
      titreNatif.remove();

      point.addEventListener("pointerenter", (event) => {
        const cadre = carte.getBoundingClientRect();
        afficher(point, event.clientX - cadre.left, event.clientY - cadre.top);
      });

      point.addEventListener("pointermove", (event) => {
        const cadre = carte.getBoundingClientRect();
        afficher(point, event.clientX - cadre.left, event.clientY - cadre.top);
      });

      point.addEventListener("pointerleave", masquer);
      point.addEventListener("blur", masquer);
      point.addEventListener("focus", () => {
        const cadre = carte.getBoundingClientRect();
        const position = point.getBoundingClientRect();
        afficher(
          point,
          position.left - cadre.left + position.width / 2,
          position.top - cadre.top,
        );
      });
    });
  });
</script>
