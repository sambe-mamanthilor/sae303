---
import data from "../assets/data/v4-mois.json";

const years = [...new Set(data.map((d) => d.annee))];
const firstYear = Math.min(...years);
const lastYear = Math.max(...years);
---

<div class="space-y-5">
  <div class="rounded-xl bg-slate-100 p-4 dark:bg-slate-800">
    <label for="annee-v4-number" class="block font-semibold text-slate-800 dark:text-slate-100">
      Choisissez une année : quels mois étaient plus chauds ou plus froids que la normale 1961–1990 ?
    </label>
    <div class="mt-4 flex flex-col gap-4 sm:flex-row sm:items-center">
      <input
        id="annee-v4-number"
        class="w-28 rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
        type="number"
        min={firstYear}
        max={lastYear}
        value={lastYear}
      />
      <input
        id="annee-v4-range"
        class="w-full cursor-pointer accent-teal-700 dark:accent-teal-300"
        type="range"
        min={firstYear}
        max={lastYear}
        value={lastYear}
        step="1"
        aria-label="Choisir l’année avec un curseur"
      />
    </div>
    <div class="mt-1 flex justify-between text-sm text-slate-600 dark:text-slate-300" aria-hidden="true">
      <span>{firstYear}</span>
      <span>{lastYear}</span>
    </div>
  </div>
  <div id="graphique-v4" aria-live="polite"></div>
</div>

<script>
  import * as Plot from "@observablehq/plot";
  import data from "../assets/data/v4-mois.json";

  const yearInput = document.querySelector("#annee-v4-number") as HTMLInputElement;
  const yearRange = document.querySelector("#annee-v4-range") as HTMLInputElement;
  const container = document.querySelector("#graphique-v4") as HTMLDivElement;
  const abbreviations = ["Jan", "Fév", "Mar", "Avr", "Mai", "Jui", "Juil", "Aoû", "Sep", "Oct", "Nov", "Déc"];

  function graphiqueV4(donnees: typeof data, annee: number) {
    return Plot.plot({
      width: Math.min(container.clientWidth || 1000, 1000),
      height: 420,
      marginLeft: 65,
      marginBottom: 55,
      title: `Écart mensuel à la référence 1961–1990 à AERO-MTBL en ${annee}`,
      subtitle:
        "Rouge : mois plus chaud que la référence mensuelle. Bleu : mois plus froid.",
      caption:
        "Source : Météo-France, Longues Séries Homogénéisées, station AERO-MTBL, données Q_HOM = 1.",
      ariaLabel: `Graphique des écarts mensuels de température maximale à AERO-MTBL en ${annee}.`,
      style: { background: "transparent", color: "currentColor" },
      x: {
        label: null,
        domain: donnees.map((d) => d.mois),
        tickFormat: (month) => abbreviations[month - 1],
      },
      y: { label: "Écart à la référence (°C)", grid: true },
      marks: [
        Plot.ruleY([0], { stroke: "#334155" }),
        Plot.barY(donnees, {
          x: "mois",
          y: "ecart",
          fill: (d) => (d.ecart >= 0 ? "#d95f4f" : "#4776b4"),
          title: (d) => `${d.nomMois} ${annee}\nÉcart : ${d.ecart.toFixed(2).replace(".", ",")} °C`,
          tip: true,
        }),
      ],
    });
  }

  function renderPlot(year: number) {
    const selectedData = data.filter((d) => d.annee === year);
    yearInput.value = String(year);
    yearRange.value = String(year);
    container.replaceChildren(graphiqueV4(selectedData, year));
  }

  yearRange.addEventListener("input", () => renderPlot(Number(yearRange.value)));
  yearInput.addEventListener("input", () => {
    const year = Number(yearInput.value);
    if (year >= Number(yearInput.min) && year <= Number(yearInput.max)) {
      renderPlot(year);
    }
  });
  renderPlot(Number(yearRange.value));
</script>
