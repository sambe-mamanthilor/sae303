---
import * as Plot from "@observablehq/plot";
import PlotFigure from "./PlotFigure.astro";

interface Row {
  annee: number;
  anomalieTX: number;
  anomalieRR: number;
  anomalieTX10: number | null;
  anomalieRR10: number | null;
}

interface Props {
  data: Row[];
}

const { data } = Astro.props;
const smoothed = data.filter((d) => d.anomalieTX10 !== null && d.anomalieRR10 !== null);

function correlation(donnees: Row[]) {
  const moyenneTX = donnees.reduce((sum, d) => sum + d.anomalieTX, 0) / donnees.length;
  const moyenneRR = donnees.reduce((sum, d) => sum + d.anomalieRR, 0) / donnees.length;
  const covariance = donnees.reduce(
    (sum, d) => sum + (d.anomalieTX - moyenneTX) * (d.anomalieRR - moyenneRR),
    0,
  );
  const ecartTX = Math.sqrt(
    donnees.reduce((sum, d) => sum + (d.anomalieTX - moyenneTX) ** 2, 0),
  );
  const ecartRR = Math.sqrt(
    donnees.reduce((sum, d) => sum + (d.anomalieRR - moyenneRR) ** 2, 0),
  );
  return covariance / (ecartTX * ecartRR);
}

const correlationAnnuelle = correlation(data);
const correlationAffichee = correlationAnnuelle
  .toFixed(2)
  .replace("-", "−")
  .replace(".", ",");

function graphiqueTemperature(donnees: Row[]) {
  return {
    width: 1000,
    height: 250,
    marginLeft: 70,
    marginRight: 25,
    marginBottom: 45,
    title: "Température maximale (TX)",
    subtitle: "Anomalies annuelles et moyenne mobile sur dix ans.",
    ariaLabel: "Évolution des anomalies de température maximale à Dorans entre 1959 et 2018.",
    style: { background: "transparent", color: "currentColor" },
    x: { label: null, domain: [1959, 2018], tickFormat: (year) => String(year) },
    y: { label: "Anomalie (°C)", grid: true },
    marks: [
      Plot.ruleY([0], { stroke: "#334155" }),
      Plot.dot(donnees, { x: "annee", y: "anomalieTX", r: 2.5, fill: "#e45756", opacity: 0.35, tip: true }),
      Plot.lineY(smoothed, { x: "annee", y: "anomalieTX10", stroke: "#c43c39", strokeWidth: 3, tip: true }),
    ],
  };
}

function graphiquePluie(donnees: Row[]) {
  return {
    width: 1000,
    height: 270,
    marginLeft: 70,
    marginRight: 25,
    marginBottom: 50,
    title: "Précipitations (RR)",
    subtitle: "Les précipitations restent très variables malgré la hausse de la température.",
    caption:
      "Source : Météo-France, Longues Séries Homogénéisées, station Dorans. Référence 1961–1990. Les deux indicateurs utilisent des échelles séparées.",
    ariaLabel: "Évolution des anomalies de précipitations à Dorans entre 1959 et 2018.",
    style: { background: "transparent", color: "currentColor" },
    x: { label: "Année", domain: [1959, 2018], tickFormat: (year) => String(year) },
    y: { label: "Anomalie (mm/an)", grid: true },
    marks: [
      Plot.ruleY([0], { stroke: "#334155" }),
      Plot.dot(donnees, { x: "annee", y: "anomalieRR", r: 2.5, fill: "#3b82a0", opacity: 0.35, tip: true }),
      Plot.lineY(smoothed, { x: "annee", y: "anomalieRR10", stroke: "#236782", strokeWidth: 3, tip: true }),
    ],
  };
}
---

<div class="space-y-3">
  <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-slate-700 dark:text-slate-300" aria-label="Légende des graphiques">
    <span class="inline-flex items-center gap-2"><span class="h-3 w-3 rounded-full bg-slate-400 opacity-50" aria-hidden="true"></span>Points : valeurs annuelles</span>
    <span class="inline-flex items-center gap-2"><span class="h-1 w-8 rounded-full bg-slate-700 dark:bg-slate-200" aria-hidden="true"></span>Lignes : moyennes mobiles sur dix ans</span>
  </div>
  <PlotFigure options={graphiqueTemperature(data)} />
  <PlotFigure options={graphiquePluie(data)} />
  <p class="text-lg font-semibold text-slate-800 dark:text-slate-100">
    Corrélation annuelle faible (r = {correlationAffichee}) : cette comparaison ne démontre pas de relation causale.
  </p>
</div>
