---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Climat du Pays de Montbéliard",
  description = "Évolution des températures maximales dans le Pays de Montbéliard depuis 1959.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.toggle(
        "dark",
        localStorage.theme === "dark" ||
          (!("theme" in localStorage) &&
            window.matchMedia("(prefers-color-scheme: dark)").matches),
      );
    </script>
  </head>
  <body class="min-h-screen bg-stone-50 text-slate-900 transition-colors dark:bg-slate-950 dark:text-slate-100">
    <a
      href="#contenu"
      class="sr-only z-50 rounded-md bg-white px-4 py-2 font-semibold text-slate-950 focus:not-sr-only focus:fixed focus:left-4 focus:top-4"
    >
      Aller au contenu
    </a>

    <header class="border-b border-slate-200 bg-white/95 transition-colors dark:border-slate-700 dark:bg-slate-900/95">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3 sm:px-5 sm:py-4">
        <a href="/" class="min-w-0 font-bold text-slate-950 dark:text-white">
          <span>Climat en mutation</span><span class="hidden sm:inline"> · Pays de Montbéliard</span>
        </a>

        <div class="flex items-center gap-2">
          <nav class="hidden md:block" aria-label="Navigation principale">
            <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium text-slate-700 dark:text-slate-200">
              <li><a class="hover:text-teal-800 dark:hover:text-teal-300" href="/#contexte">Contexte</a></li>
              <li><a class="hover:text-teal-800 dark:hover:text-teal-300" href="/#exploration">Exploration</a></li>
              <li><a class="hover:text-teal-800 dark:hover:text-teal-300" href="/#revelation">Révélation</a></li>
              <li><a class="hover:text-teal-800 dark:hover:text-teal-300" href="/#conclusion">Conclusion</a></li>
              <li><a class="hover:text-teal-800 dark:hover:text-teal-300" href="/methode/">Méthode</a></li>
            </ul>
          </nav>

          <button
            id="theme-toggle"
            type="button"
            role="switch"
            class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-2.5 py-2 text-sm font-medium text-slate-700 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-100 dark:hover:bg-slate-700"
            aria-checked="false"
          >
            <span data-theme-label class="max-[360px]:sr-only">Mode sombre</span>
            <span class="relative h-6 w-11 shrink-0 rounded-full bg-slate-300 transition-colors dark:bg-teal-500" aria-hidden="true">
              <span class="absolute left-1 top-1 h-4 w-4 rounded-full bg-white shadow-sm transition-transform dark:translate-x-5"></span>
            </span>
          </button>

          <button
            id="menu-toggle"
            type="button"
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-teal-700 text-xl text-white transition hover:bg-teal-800 dark:bg-teal-300 dark:text-slate-950 dark:hover:bg-teal-200 md:hidden"
            aria-label="Ouvrir le menu"
            aria-controls="mobile-menu"
          >
            <span aria-hidden="true">☰</span>
          </button>
        </div>
      </div>
    </header>

    <dialog id="mobile-menu" class="fixed inset-y-0 left-auto right-0 m-0 h-dvh max-h-none w-80 max-w-[88vw] bg-white p-0 text-slate-950 shadow-2xl backdrop:bg-slate-950/55 dark:bg-slate-900 dark:text-white md:hidden">
      <div class="flex h-full flex-col p-5">
        <div class="flex items-center justify-between gap-4 border-b border-slate-200 pb-5 dark:border-slate-700">
          <p class="font-bold">Navigation</p>
          <button id="menu-close" type="button" class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-2xl hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700" aria-label="Fermer le menu">×</button>
        </div>
        <nav class="mt-5" aria-label="Navigation mobile">
          <ul class="grid gap-2 font-medium">
            <li><a class="block rounded-xl px-4 py-3 hover:bg-teal-50 hover:text-teal-800 dark:hover:bg-slate-800 dark:hover:text-teal-300" href="/#contexte">Contexte</a></li>
            <li><a class="block rounded-xl px-4 py-3 hover:bg-teal-50 hover:text-teal-800 dark:hover:bg-slate-800 dark:hover:text-teal-300" href="/#exploration">Exploration</a></li>
            <li><a class="block rounded-xl px-4 py-3 hover:bg-teal-50 hover:text-teal-800 dark:hover:bg-slate-800 dark:hover:text-teal-300" href="/#revelation">Révélation</a></li>
            <li><a class="block rounded-xl px-4 py-3 hover:bg-teal-50 hover:text-teal-800 dark:hover:bg-slate-800 dark:hover:text-teal-300" href="/#conclusion">Conclusion</a></li>
            <li><a class="block rounded-xl px-4 py-3 hover:bg-teal-50 hover:text-teal-800 dark:hover:bg-slate-800 dark:hover:text-teal-300" href="/methode/">Méthode</a></li>
          </ul>
        </nav>
      </div>
    </dialog>

    <slot />

    <footer class="mt-20 border-t border-slate-200 bg-slate-950 text-slate-200 dark:border-slate-800 dark:bg-black">
      <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-8 text-sm sm:flex-row sm:items-center sm:justify-between">
        <p>SAÉ 303 · Ruslana Budniak et Mamanthilor Sambe</p>
        <p>Données Météo-France · Licence Ouverte 2.0</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const themeButton = document.querySelector("#theme-toggle") as HTMLButtonElement;
  const themeLabel = themeButton.querySelector("[data-theme-label]") as HTMLSpanElement;

  function updateThemeButton() {
    const dark = document.documentElement.classList.contains("dark");
    themeButton.setAttribute("aria-checked", String(dark));
    themeLabel.textContent = dark ? "Mode clair" : "Mode sombre";
  }

  themeButton.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.theme = dark ? "dark" : "light";
    updateThemeButton();
  });

  updateThemeButton();

  const menuButton = document.querySelector("#menu-toggle") as HTMLButtonElement;
  const menuCloseButton = document.querySelector("#menu-close") as HTMLButtonElement;
  const mobileMenu = document.querySelector("#mobile-menu") as HTMLDialogElement;

  function closeMenu() {
    mobileMenu.close();
  }

  menuButton.addEventListener("click", () => {
    mobileMenu.showModal();
  });

  menuCloseButton.addEventListener("click", closeMenu);

  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMenu);
  });

  mobileMenu.addEventListener("click", (event) => {
    if (event.target === mobileMenu) {
      closeMenu();
    }
  });
</script>
